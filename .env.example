# ============================================================
#  Переменные окружения LAST HOPE
#  Локально: скопируйте в .env и заполните
#  На Vercel: Project Settings -> Environment Variables
# ============================================================

# --- База данных (Postgres) --------------------------------
# Neon даёт бесплатный Postgres. Строка вида:
#   postgresql://user:пароль@ep-xxx.aws.neon.tech/dbname?sslmode=require
# Если создавать базу через Vercel (Storage -> Neon), эта переменная
# подставится автоматически, руками добавлять не нужно.
DATABASE_URL=

# --- NextAuth ----------------------------------------------
# Секрет для подписи сессионных JWT. Сгенерировать:
#   openssl rand -base64 32
# либо на https://generate-secret.vercel.app/32
NEXTAUTH_SECRET=

# Канонический адрес сайта. Локально http://localhost:3000
# На проде — ваш домен, например https://lasthope.ru
NEXTAUTH_URL=

# --- Хранилище фото точек ----------------------------------
# Подставляется Vercel автоматически при подключении Blob-хранилища
# (Storage -> Blob -> Connect to Project). Локально можно оставить
# пустым — загрузка фото тогда вернёт понятную ошибку вместо падения.
BLOB_READ_WRITE_TOKEN=

# --- Создание первого админа -------------------------------
# Используются только скриптом `npm run db:seed`, на проде не нужны.
# Пароль минимум 8 символов, хранится в базе как bcrypt-хэш.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
